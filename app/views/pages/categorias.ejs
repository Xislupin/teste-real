<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/css/home.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>

    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>

    <script src="/js/home.js" defer></script>

</head>

<body class="home-body">
    <%- include("../partials/header") %>

        <main class="home-main">
            <section class="home-hero">
                <section class="home-hero-content">
                    <p class="home-label">
                        <span></span>
                        NAVEGUE POR NECESSIDADE
                    </p>
                    <h1 class="home-title">Categorias de medicamentos</h1>
                    <p class="home-description">Encontre medicamentos e produtos de saúde de forma simples e organizada</p>
                    <section class="home-categorias-lista">
                        <a href="/categorias/dor-e-febre" class="home-categoria-card">
                            <section class="home-categoria-icone">
                                <ion-icon name="bandage-outline" role="img" class="md hydrated"></ion-icon>
                            </section>
                            <section class="home-categoria-info">
                                <strong>Dor e febre</strong>
                                <small>128 produtos</small>
                            </section>
                            <ion-icon class="home-categoria-seta md hydrated" name="chevron-forward-outline" role="img">
                            </ion-icon>
                        </a>
                        <a href="/categorias/vitaminas" class="home-categoria-card">
                            <section class="home-categoria-icone">
                                <ion-icon name="shield-checkmark-outline" role="img" class="md hydrated"></ion-icon>
                            </section>
                            <section class="home-categoria-info">
                                <strong>Vitaminas</strong>
                                <small>74 produtos</small>
                            </section>
                            <ion-icon class="home-categoria-seta md hydrated" name="chevron-forward-outline" role="img">
                            </ion-icon>
                        </a>
                        <a href="/categorias/alergias" class="home-categoria-card">
                            <section class="home-categoria-icone">
                                <ion-icon name="checkmark-outline" role="img" class="md hydrated"></ion-icon>
                            </section>
                            <section class="home-categoria-info">
                                <strong>Alergias</strong>
                                <small>74 produtos</small>
                            </section>
                            <ion-icon class="home-categoria-seta md hydrated" name="chevron-forward-outline" role="img">
                            </ion-icon>
                        </a>
                        <a href="/categorias/coracao" class="home-categoria-card">
                            <section class="home-categoria-icone">
                                <ion-icon name="heart-outline" role="img" class="md hydrated"></ion-icon>
                            </section>
                            <section class="home-categoria-info">
                                <strong>Coração e Circulação</strong>
                                <small>74 produtos</small>
                            </section>
                            <ion-icon class="home-categoria-seta md hydrated" name="chevron-forward-outline" role="img">
                            </ion-icon>
                        </a>
                    </section>
                </section>
            </section>
        </main>
            <%- include("../partials/footer") %>

</body>

</html>