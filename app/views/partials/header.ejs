<header class="home-header">

    <a href="/" class="home-logo">
        <img
            src="public/imagens/logo/fund-transp.png
            alt="BioClicky"
        >
    </a>

    <nav class="home-nav">

        <a href="/">
            Buscar
        </a>

        <a href="/categorias">
            Categorias
        </a>

        <a href="/farmacias">
            Farmácias
        </a>

        <a href="#como-funciona">
            Como funciona
        </a>

    </nav>


    <section class="home-header-actions">

        <section class="home-theme">

            <button
                type="button"
                class="home-theme-option home-theme-light"
            >
                <ion-icon name="sunny-outline"></ion-icon>
                <span>Claro</span>
            </button>

            <button
                type="button"
                class="home-theme-option home-theme-dark"
            >
                <ion-icon name="moon-outline"></ion-icon>
                <span>Escuro</span>
            </button>

        </section>


        <a
            href="#"
            class="home-favorite"
            aria-label="Favoritos"
        >
            <ion-icon name="heart-outline"></ion-icon>
        </a>


        <a href="/login" class="home-login">

            <ion-icon name="person-outline"></ion-icon>

            <span>Entrar</span>

        </a>

    </section>


    <button
        type="button"
        class="home-mobile-menu"
        aria-label="Abrir menu"
    >
        <ion-icon name="menu-outline"></ion-icon>
    </button>

</header>